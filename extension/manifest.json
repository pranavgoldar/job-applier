{
  "manifest_version": 3,
  "name": "Career OS Autofill",
  "version": "2.1.0",
  "description": "Fills job application forms from your Career OS dashboard, on any job site. You review and press Submit yourself.",
  "permissions": ["storage", "activeTab", "scripting", "webNavigation"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Career OS Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://job-applier-beta.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["<all_urls>"]
}
